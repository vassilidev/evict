// Icon, manifest (DPI, common controls 6, long paths) and version details, written by build.sh in details.h
#include <windows.h>
#include "details.h"

1 ICON "evict.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "evict.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VERSION_NUMS
PRODUCTVERSION VERSION_NUMS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "vassilidev"
      VALUE "FileDescription", FILE_DESCRIPTION
      VALUE "FileVersion", VERSION
      VALUE "InternalName", "Evict"
      VALUE "LegalCopyright", "Copyright (c) 2026 vassilidev, MIT License"
      VALUE "OriginalFilename", ORIGINAL_NAME
      VALUE "ProductName", "Evict"
      VALUE "ProductVersion", VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
